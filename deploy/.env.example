# --- Frontend (public, safe to expose to the browser) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Backend only (NEVER expose to the frontend) ---
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# JWT validation: asymmetric (RS256/ES256) tokens are verified via the JWKS
# endpoint derived from SUPABASE_URL (https://.../auth/v1/.well-known/jwks.json).
# JWT_SECRET is the legacy HS256 fallback, only needed while the Supabase
# project still uses the legacy JWT secret. After migrating to asymmetric
# signing keys and revoking the legacy secret, leave JWT_SECRET empty.
JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
# Optional: override the JWKS URL (defaults to SUPABASE_URL/auth/v1/.well-known/jwks.json)
SUPABASE_JWKS_URL=
# Secret bearer token for external cron triggers (for example cron-job.org).
# Send as: Authorization: Bearer <CRON_API_TOKEN>
CRON_API_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Upload backup retention (days) — used by scripts/backup_uploads.sh
BACKUP_RETENTION_DAYS=30
